{
  "name": "Dev Container Fortress (Alpine)",
  "build": {
    "dockerfile": "../../containers/alpine/Dockerfile",
    "context": "../..",
    "args": {
      "CORPORATE_CA_CERT_DIR": "${localEnv:DEV_CONTAINER_FORTRESS_CA_CERT_DIR}",
      "SHELL_CONFIG_SOURCE": "${localEnv:DEV_CONTAINER_FORTRESS_SHELL_CONFIG_SOURCE:github}",
      "SHELL_CONFIG_REPO_URL": "${localEnv:DEV_CONTAINER_FORTRESS_SHELL_CONFIG_REPO_URL}",
      "SHELL_CONFIG_BRANCH": "${localEnv:DEV_CONTAINER_FORTRESS_SHELL_CONFIG_BRANCH:main}",
      "SHELL_CONFIG_LOCAL_DIR": "${localEnv:DEV_CONTAINER_FORTRESS_SHELL_CONFIG_LOCAL_DIR}",
      "SHELL_CONFIG_PROFILE_DEFAULT": "${localEnv:DEV_CONTAINER_FORTRESS_SHELL_CONFIG_PROFILE_DEFAULT:zsh-tll-citadel-dev-fortress}",
      "SHELL_CONFIG_INSTALL_ZINIT": "${localEnv:DEV_CONTAINER_FORTRESS_SHELL_CONFIG_INSTALL_ZINIT:1}"
    }
  },
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.local/state/dev-container-fortress/browser-bridge\" && if command -v ft >/dev/null 2>&1; then ft devcontainer browser-bridge \"${localEnv:HOME}/.local/state/dev-container-fortress/browser-bridge\" || true; fi",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "containerEnv": {
    "DEV_CONTAINER_FORTRESS_OPTIONS": "${localEnv:DEV_CONTAINER_FORTRESS_OPTIONS}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "BROWSER": "/usr/local/bin/ft-host-browser-open",
    "GH_BROWSER": "/usr/local/bin/ft-host-browser-open",
    "DEV_FORTRESS_HOST_BROWSER_SOCKET": "/tmp/dev-fortress-host-services/browser-open.sock"
  },
  "mounts": [
    {
      "source": "dev-fortress-state-${devcontainerId}",
      "target": "/home/vscode/.local/state",
      "type": "volume"
    },
    {
      "source": "dev-fortress-zoxide-${devcontainerId}",
      "target": "/home/vscode/.local/share/zoxide",
      "type": "volume"
    },
    {
      "source": "dev-fortress-atuin-${devcontainerId}",
      "target": "/home/vscode/.local/share/atuin",
      "type": "volume"
    },
    {
      "source": "dev-fortress-claude-${devcontainerId}",
      "target": "/home/vscode/.claude",
      "type": "volume"
    },
    {
      "source": "dev-fortress-claude-versions-${devcontainerId}",
      "target": "/home/vscode/.local/share/claude",
      "type": "volume"
    },
    {
      "source": "${localEnv:HOME}/.local/state/dev-container-fortress/browser-bridge",
      "target": "/tmp/dev-fortress-host-services",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postCreateCommand": "ft plan --manifest /home/vscode/.local/share/dev-container-fortress/ft/tools/tools.toml --target alpine",
  "postStartCommand": "ft-ensure-claude-code --if-selected"
}
