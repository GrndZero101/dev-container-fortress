{
  "name": "Dev Container Fortress (volume)",
  "image": "${localEnv:DEV_FORTRESS_IMAGE:ghcr.io/grndzero101/dev-container-fortress:ubuntu}",
  "workspaceMount": "type=volume,source=dev-fortress-src-${localWorkspaceFolderBasename},target=/workspaces",
  "workspaceFolder": "/workspaces",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "containerEnv": {
    "DEV_CONTAINER_FORTRESS_OPTIONS": "${localEnv:DEV_CONTAINER_FORTRESS_OPTIONS}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "mounts": [
    {
      "source": "dev-fortress-state-${devcontainerId}",
      "target": "/home/vscode/.local/state",
      "type": "volume"
    },
    {
      "source": "dev-fortress-zoxide-${devcontainerId}",
      "target": "/home/vscode/.local/share/zoxide",
      "type": "volume"
    },
    {
      "source": "dev-fortress-atuin-${devcontainerId}",
      "target": "/home/vscode/.local/share/atuin",
      "type": "volume"
    },
    {
      "source": "dev-fortress-claude-${devcontainerId}",
      "target": "/home/vscode/.claude",
      "type": "volume"
    },
    {
      "source": "dev-fortress-claude-versions-${devcontainerId}",
      "target": "/home/vscode/.local/share/claude",
      "type": "volume"
    },
    {
      "source": "dev-fortress-gh-${devcontainerId}",
      "target": "/home/vscode/.config/gh",
      "type": "volume"
    },
    {
      "source": "dev-fortress-glab-${devcontainerId}",
      "target": "/home/vscode/.config/glab-cli",
      "type": "volume"
    },
    {
      "source": "dev-fortress-brew-${devcontainerId}",
      "target": "/home/linuxbrew/.linuxbrew",
      "type": "volume"
    }
  ],
  "postStartCommand": "ft-brew-floor && ft-ensure-claude-code --if-selected"
}
